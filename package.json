{
  "name": "cubic-teamwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local",
    "build": "vite build",
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cubic_teamwork --local",
    "db:migrate": "wrangler d1 migrations apply cubic_teamwork --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^4.127.1"
  }
}
