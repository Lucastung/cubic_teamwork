{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubic-teamwork",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cubic-teamwork-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cubic_teamwork",
      "database_id": "82279d89-5aed-4125-b569-87b6fc80a12c",
      "migrations_dir": "migrations"
    }
  ]
}
